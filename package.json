{
  "name": "markxia",
  "version": "1.1.0",
  "description": "MarkXia: Figma Markdown Editor & Viewer Widget",
  "main": "dist/code.js",
  "scripts": {
    "build": "esbuild widget-src/code.tsx --bundle --outfile=dist/code.js --target=es2020",
    "watch": "esbuild widget-src/code.tsx --bundle --outfile=dist/code.js --target=es2020 --watch",
    "tsc": "tsc --noEmit -p widget-src",
    "lint": "eslint widget-src --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/widget-typings": "^1.2.0",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.59.7",
    "esbuild": "^0.17.19",
    "eslint": "^8.41.0",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.60.0"
  }
}
